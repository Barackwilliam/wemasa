# Copy to .env for local development. On the server, set these as environment variables.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Supabase Postgres (leave empty locally to use SQLite)
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage (S3-compatible). Leave empty locally to store uploads in ./media
SUPABASE_PROJECT_REF=
SUPABASE_BUCKET=wemasa-media
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_REGION=eu-central-1

# First dashboard administrator (python manage.py ensure_admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email for contact-form notifications (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WEMASA Tanzania <no-reply@wemasa.or.tz>
CONTACT_NOTIFY_EMAILS=wemasatanzania@gmail.com
